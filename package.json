{
  "name": "koth-pinball",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"pnpm --filter @koth/server dev\" \"pnpm --filter @koth/web dev\"",
    "cert": "node scripts/cert.mjs",
    "build": "pnpm --filter @koth/web build",
    "lint": "eslint . && node scripts/check-styles.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vue-eslint-parser": "^10.1.3"
  }
}
